# Model: required. The key for model.provider: OPENAI_API_KEY (openai), ANTHROPIC_API_KEY (anthropic), or the
# variable named by model.api_key_env (openai_compatible)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_API_KEY=

# Slack (chat.slack): bot token xoxb-... and app-level token xapp-... with connections:write
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Microsoft Teams (chat.teams): the Azure Bot's app registration
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=

# Google Chat and Google Drive: path to the service account JSON key, for example secrets/<file>.json
GOOGLE_SERVICE_ACCOUNT_FILE=

# Confluence docs source: an Atlassian account email and API token
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# src/extensions/jira.ts: its tools are added only when all three are set
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
